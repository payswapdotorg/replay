# env.sh.example — optional runtime config for the replay console.
#
# Copy to scripts/env.sh (gitignored) and adjust. NOTHING here is required:
# with no env.sh at all, the console runs fine (the optional repo-status card
# stays hidden).
#
# REPO — "owner/name" of a GitHub repo whose branch/PR summary should show in
#        the console side panel. Public repos need no token.
# OPERATOR_PAT — GitHub token, ONLY needed if REPO is private or you hit API
#        rate limits. Treat as a secret: never commit it.

# export REPO=myorg/myrepo
# export OPERATOR_PAT=ghp_xxxxxxxxxxxxxxxxxxxx
